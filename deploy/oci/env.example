# Templates for the four files compose reads. None of them is committed: copy each
# block to the named file in deploy/oci/ on the VM and fill it in (chmod 600).

# ---- .env (compose variable substitution) ----
# Any long random string; only Postgres and the containers on this VM use it.
POSTGRES_PASSWORD=

# ---- netbox.env ----
# localhost is for the container health checks; only the VM itself can send it.
ALLOWED_HOSTS=netbox.lydfirmaetekko.no,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://netbox.lydfirmaetekko.no
TIME_ZONE=Europe/Oslo
# Use the SAME values as the Cloudflare Worker secrets. SECRET_KEY signs sessions
# and password-reset links; API_TOKEN_PEPPERS ("1=<pepper>") is needed for existing
# v2 API tokens to keep working. New values only mean everyone logs in again and
# v2 tokens must be reissued.
SECRET_KEY=
API_TOKEN_PEPPERS=

# ---- tunnel.env ----
# Token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels > the tunnel >
# install connector). Its public hostname must point at http://nginx:80.
TUNNEL_TOKEN=

# ---- backup.env ----
# R2 API token scoped to Object Read & Write on the netbox-media bucket
# (R2 > Manage API tokens). The endpoint is the account's S3 endpoint.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://043e07d8df6b7bc18247ec3a5870faec.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
R2_BUCKET=netbox-media
BACKUP_PREFIX=oci
BACKUPS_TO_KEEP=14
